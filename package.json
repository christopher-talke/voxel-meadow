{
  "name": "voxel-meadow",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "description": "A gentle 3D voxel meadow where Murphy, Mali, Bobby, Billy and Ashy still live.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && node tools/check-boundary.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "sh -c 'P=python3; [ -x .venv/bin/python ] && P=.venv/bin/python; $P test/soak.py'"
  },
  "devDependencies": {
    "@types/three": "0.128.0",
    "three": "0.128.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
